NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:root@localhost:3306/ecommerce_platform
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
LOG_LEVEL=info
# Generate separate random values; never commit real secrets.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
COOKIE_SECURE=false
# Optional development-only admin seed values. Set all three together.
SEED_ADMIN_NAME=Development Admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-development-password
